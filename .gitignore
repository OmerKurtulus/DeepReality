# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
venv/
.env

# ── Operating system and editors ──
.DS_Store
.vscode/
.idea/
.claude/

# ── Large model weights ──
# Excluded because they exceed GitHub's 100 MB per-file limit.
# Download links and placement instructions: models/README.md
# The trained PIN-F1 artefact is small and IS tracked, so the ensemble
# stage works from a fresh clone without any download.
models/*.pt
models/pin_b4_ai_deepfake_real/model.safetensors

# ── Test images and analysis output ──
# Personal photographs are excluded; one AI-generated sample is tracked so
# the pipeline can be exercised straight after cloning.
input/*
!input/.gitkeep
!input/sample_ai_generated.png
outputs/*
!outputs/.gitkeep

# ── Files outside the project scope ──
index.html
