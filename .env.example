# DeepReality — Environment Configuration (template)
#
# Copy this file to `.env` and fill in your credentials:
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed.

# ─────────────────────────────────────────────────────────────
# LAYER 5 — LLM Reasoning Engine (PIN-E1)
# ─────────────────────────────────────────────────────────────

# API key for the reasoning provider.
# Obtain one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Reasoning model. Paste any model identifier from openrouter.ai/models
# here — no source change is required. Identifiers ending in ":free"
# use OpenRouter's free tier.
#
#   anthropic/claude-sonnet-4.5     recommended — strongest evidence synthesis
#   google/gemma-4-26b-a4b-it:free  free tier, adequate for smoke tests
#   openai/gpt-4o-mini              lower cost
#   google/gemini-2.0-flash-001     lower latency
#
# The reasoning protocol is demanding: it requires strict JSON output and
# multi-step evidence weighting under an ordered rule set. Smaller models
# produce shallower justifications and occasionally malformed JSON, which
# PIN-E1 repairs where it can. Use a frontier model for production work.
DEEPREALITY_LLM_MODEL=anthropic/claude-sonnet-4.5

# Provider endpoint. Any OpenAI-compatible chat-completions API works.
#   OpenRouter : https://openrouter.ai/api/v1
#   OpenAI     : https://api.openai.com/v1
# DEEPREALITY_LLM_API_BASE=https://openrouter.ai/api/v1
