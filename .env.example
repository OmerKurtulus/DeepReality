# DeepReality — Environment Configuration (template)
#
# Copy this file to `.env` and fill in your credentials:
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed.

# ─────────────────────────────────────────────────────────────
# LAYER 5 — LLM Reasoning Engine (PIN-E1)
# ─────────────────────────────────────────────────────────────

# API key for the reasoning provider.
# Obtain one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides — sensible defaults are defined in config/settings.py.
#
# Any OpenAI-compatible chat-completions endpoint is supported.
#   OpenRouter : https://openrouter.ai/api/v1
#   OpenAI     : https://api.openai.com/v1
# DEEPREALITY_LLM_API_BASE=https://openrouter.ai/api/v1

# Reasoning model identifier.
#   anthropic/claude-sonnet-4.5   — recommended, strongest evidence synthesis
#   openai/gpt-4o-mini            — lower cost
#   google/gemini-2.0-flash-001   — lower latency
# DEEPREALITY_LLM_MODEL=anthropic/claude-sonnet-4.5
